{
  "sourceLanguage": "en",
  "strings": {
    "1.0 is linear; higher needs a firmer touch, lower is lighter.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1.0 is linear; higher needs a firmer touch, lower is lighter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1,0 est linéaire ; plus haut demande un appui plus ferme, plus bas est plus léger."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1.0 がリニア。大きくすると強く押す必要があり、小さくすると軽くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1.0은 선형입니다. 높을수록 더 세게, 낮을수록 더 가볍게 누르면 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1.0 为线性；数值越大需要越用力，越小越轻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1.0 為線性；越高需要越用力，越低越輕。"
          }
        }
      }
    },
