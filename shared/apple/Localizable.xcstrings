    "16–8192 pixels per side. Undo, the brush tape and imports scale with this canvas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "16–8192 pixels per side. Undo, the brush tape and imports scale with this canvas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "16 à 8192 pixels par côté. L'annulation, la bande de pinceau et les imports suivent ce canevas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各辺 16–8192 ピクセル。取り消し、ブラシテープ、読み込みはこのキャンバスに合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 변 16–8192픽셀. 실행 취소, 브러시 테이프, 가져오기는 이 캔버스에 맞춰집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每边 16–8192 像素。撤销、笔刷录制带和导入都会跟随这块画布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每邊 16–8192 像素。復原、筆刷錄製帶與匯入會隨此畫布縮放。"
          }
        }
      }
    },
