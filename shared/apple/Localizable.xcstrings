    "System follows the macOS language. A language change applies when DrawKit reopens.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System follows the macOS language. A language change applies when DrawKit reopens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système suit la langue de macOS. Un changement de langue s'applique à la réouverture de DrawKit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムは macOS の言語に従います。言語の変更は DrawKit を開き直すと反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템은 macOS 언어를 따릅니다. 언어 변경은 DrawKit을 다시 열면 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统跟随 macOS 语言设置。修改语言后重新打开 DrawKit 生效。"
