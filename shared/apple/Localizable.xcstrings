    "Pencil and tablet pressure, tilt and rotation reach the stroke. Mirror can paint both sides at once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencil and tablet pressure, tilt and rotation reach the stroke. Mirror can paint both sides at once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pression, l'inclinaison et la rotation du stylet et de la tablette atteignent le trait. Le miroir peut peindre les deux côtés à la fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筆圧、傾き、回転がストロークに記録されます。ミラーで両側を同時に描けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연필과 태블릿의 필압, 기울기, 회전이 획에 전달됩니다. 대칭으로 양쪽을 동시에 그릴 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压感、倾角和旋转都会写进笔画。镜像可以同时画两侧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鉛筆與繪圖板的壓力、傾斜與旋轉會傳到筆畫。鏡像可以同時畫兩側。"
          }
        }
      }
    },
