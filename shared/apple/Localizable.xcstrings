    "Pick the app whose shortcuts you already use. Individual keys can be changed later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the app whose shortcuts you already use. Individual keys can be changed later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'app dont vous connaissez déjà les raccourcis. Les touches peuvent être modifiées ensuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い慣れたアプリのショートカットを選びます。個別のキーは後で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 쓰는 앱의 단축키를 고르세요. 나중에 개별 키를 바꿀 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
