    "Keeps highlights above paper white; export EXR to keep them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps highlights above paper white; export EXR to keep them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les hautes lumières au-dessus du blanc du papier ; exportez en EXR pour les garder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙の白を超えるハイライトを保持。EXR で書き出すと残せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종이 흰색 위의 하이라이트를 유지합니다. EXR로 내보내면 보존됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留纸白以上的高光，导出 EXR 才能保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留紙白以上的高光；匯出 EXR 可保留它們。"
