          }
        }
      }
    },
    "Undo a stroke, then draw a different one. The path you left becomes a branch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo a stroke, then draw a different one. The path you left becomes a branch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez un trait puis dessinez-en un autre : le chemin abandonné devient une branche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストロークを取り消して別のものを描くと、破棄した経路が分岐になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 획을 실행 취소하고 다른 획을 그리면 버린 경로가 분기가 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销一笔后再画另一笔，被放弃的路径会成为分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原一筆後再畫另一筆，被放棄的路徑會成為分支。"
          }
        }
      }
    },
    "Undoing and drawing again keeps the abandoned path as a dormant branch. Branches live in memory only and are not saved in the project.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undoing and drawing again keeps the abandoned path as a dormant branch. Branches live in memory only and are not saved in the project."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler puis dessiner garde le chemin abandonné comme une branche dormante. Les branches ne vivent qu'en mémoire et ne sont pas enregistrées dans le projet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消してから描くと、破棄した経路が休眠ブランチとして残ります。ブランチはメモリ上だけに存在し、プロジェクトには保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 취소 후 다시 그리면 버린 경로가 휴면 분기로 남습니다. 분기는 메모리에만 있고 프로젝트에 저장되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销后再画，被放弃的路径会成为休眠分支。分支只存在于内存中，不会存入项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原後再畫，被放棄的路徑會成為休眠分支。分支只存在於記憶體中，不會存入專案。"
          }
        }
      }
    },
