    "Gap closing, growth and softening make a fill meet the line instead of leaving a pale rim.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gap closing, growth and softening make a fill meet the line instead of leaving a pale rim."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fermeture des écarts, l'extension et l'adoucissement font que le remplissage touche le trait au lieu de laisser un liseré pâle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隙間を閉じ、広げ、ぼかすことで、塗りが線に届き、白い縁を残しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간격 닫기, 확장, 부드럽게 하기로 채우기가 선에 닿아 흰 테두리를 남기지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闭合缝隙、扩展和羽化让填充贴住线条，而不是留下白边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "間隙閉合、擴張與柔化讓填色貼合線條，而不是留下一圈白邊。"
          }
        }
      }
    },
