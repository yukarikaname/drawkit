    "A crash or a quit without saving leaves the last copy for recovery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A crash or a quit without saving leaves the last copy for recovery."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fermeture ou un plantage sans sauvegarde laisse la dernière copie pour la récupération."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存せずに終了・クラッシュした場合、最後のコピーから復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 않고 종료하거나 충돌하면 마지막 사본에서 복구할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "崩溃或未保存就退出时，会保留最后一份副本以便恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "崩潰或未儲存就結束時，會保留最後一份副本以便復原。"
          }
        }
      }
    },
    "A pen, not a mouse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pen, not a mouse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un stylet, pas une souris"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスではなくペン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스가 아닌 펜"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用笔，而不是鼠标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用筆，不是滑鼠"
          }
        }
      }
    },
    "A practical painting kit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A practical painting kit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une boîte à outils de peinture pratique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実用的な描画キット。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실용적인 페인팅 키트."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实用的绘画工具箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實用的繪畫工具箱。"
          }
        }
      }
    },
    "A practical painting kit. Same core, same pixels, every screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A practical painting kit. Same core, same pixels, every screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une boîte à outils de peinture pratique. Même cœur, mêmes pixels, sur chaque écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実用的な描画キット。同じコア、同じピクセル、すべての画面で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실용적인 페인팅 키트. 같은 코어, 같은 픽셀, 모든 화면."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实用的绘画工具箱。同一个内核，同样的像素，每个屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實用的繪畫工具箱。同一個核心，同樣的像素，每個螢幕。"
          }
        }
      }
    },
    "A recovery copy of %@ from %@ is newer than the last save.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recovery copy of %@ from %@ is newer than the last save."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie de récupération de %@ datée du %@ est plus récente que la dernière sauvegarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の復元コピー（%@）が最後の保存より新しいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 복구 사본(%@)이 마지막 저장보다 최신입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 %@、%@ 的恢复副本比上次保存更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 %@ 的復原副本（%@）比上次儲存更新。"
          }
        }
      }
    },
    "A refill close to the colour already there keeps that colour": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refill close to the colour already there keeps that colour"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau remplissage proche de la couleur en place la conserve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の色に近い再塗りは、その色を保ちます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 있는 색에 가까운 다시 채우기는 그 색을 유지합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新填色时，若接近现有颜色就沿用该颜色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新填色時，若接近現有顏色就沿用該顏色"
          }
        }
      }
    },
