# Build products. A Swift build writes precompiled modules and SDK caches here; they are tens of
# megabytes, change on every build, and are reproducible from the source.
.build/
build/
.swiftpm/
target/
dist/
**/*.rs.bk
.DS_Store

# Working notes: the roadmap changes faster than the code and is not part of the build.
TODO.md

# Editor state: the shared launch config is tracked, user settings are not.
.vscode/settings.json
.vscode/*.code-workspace

# Xcode state: per-user windows, schemes and breakpoints.
**/*.xcodeproj/xcuserdata/
**/*.xcodeproj/project.xcworkspace/xcuserdata/

# Lighting training: local venv, generated images and checkpoints.
training/**/.venv/
training/lighting/data/
training/lighting/eval/
training/lighting/wheels/
training/lighting/out/

# Shading research: generated masks, downloaded references, local teacher models.
**/__pycache__/
training/shading/data/
training/shading/out/
training/shading/real/
training/shading/shadesketch/.venv/
training/shading/shadesketch/models/
training/shading/shadesketch/wheels/
training/shading/anime2sketch/

# Xcode Cloud writes this when the project is opened there; it is generated state.
**/*.xcodeproj/xcshareddata/xcodecloud/
.container/
.cache/
