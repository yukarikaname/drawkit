<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DrawKit.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="SystemAccentColor">#C5523D</Color>
            <Color x:Key="SystemAccentColorLight1">#D46A55</Color>
            <Color x:Key="SystemAccentColorLight2">#E08370</Color>
            <Color x:Key="SystemAccentColorLight3">#ED9C8B</Color>

            <!-- The palette follows the system theme. "Default" covers dark and high contrast the
                 way the WinUI templates do, so no lookup can miss. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="InkBrush" Color="#1B1917" />
                    <SolidColorBrush x:Key="CarbonBrush" Color="#24211E" />
                    <SolidColorBrush x:Key="RaisedBrush" Color="#2E2A26" />
                    <SolidColorBrush x:Key="PaperBrush" Color="#F4EFE7" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#A69E93" />
                    <SolidColorBrush x:Key="VermilionBrush" Color="#C5523D" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#33FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="InkBrush" Color="#F4F0E8" />
                    <SolidColorBrush x:Key="CarbonBrush" Color="#FBF8F2" />
                    <SolidColorBrush x:Key="RaisedBrush" Color="#EDE7DC" />
                    <SolidColorBrush x:Key="PaperBrush" Color="#23201C" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#6E665C" />
                    <SolidColorBrush x:Key="VermilionBrush" Color="#B8462F" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#22000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="RailToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="110" />
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>

            <Style x:Key="OptionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="90" />
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="OptionValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatusButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
