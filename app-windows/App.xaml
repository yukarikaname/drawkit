<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DrawKit.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The proof palette. The chrome is achromatic so the painting is the only
                 coloured thing in the window; system accent stays a neutral slate because the
                 default control templates paint their checked foreground from it. -->
            <Color x:Key="SystemAccentColor">#3A4047</Color>
            <Color x:Key="SystemAccentColorLight1">#4A5158</Color>
            <Color x:Key="SystemAccentColorLight2">#5A6269</Color>
            <Color x:Key="SystemAccentColorLight3">#6A7279</Color>

            <SolidColorBrush x:Key="InkBrush" Color="#14171A" />
            <SolidColorBrush x:Key="CarbonBrush" Color="#1D2126" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#2E343A" />
            <SolidColorBrush x:Key="PaperBrush" Color="#ECEAE4" />
            <SolidColorBrush x:Key="GraphiteBrush" Color="#14171A" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8D959D" />
            <SolidColorBrush x:Key="ProofBrush" Color="#F4F1EA" />
            <SolidColorBrush x:Key="VermilionBrush" Color="#F4F1EA" />
            <SolidColorBrush x:Key="RuleBrush" Color="#2E343A" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#2E343A" />

            <Style x:Key="RailToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
